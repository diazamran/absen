# ===== Aplikasi =====
APP_NAME=PresensiKu
# Nama sekolah (dapat diubah dari Pengaturan di aplikasi)
SCHOOL_NAME="SMA Negeri 1 Nusantara"
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
TIMEZONE=Asia/Jakarta
NODE_ENV=development

# ===== Database =====
DATABASE_URL="postgresql://presensiku:presensiku123@localhost:5432/presensiku"

# ===== Keamanan =====
# Ganti dengan nilai acak yang panjang pada production!
JWT_SECRET="dev-secret-ganti-di-production-0001"
JWT_REFRESH_SECRET="dev-refresh-secret-ganti-di-production-0002"
JWT_ACCESS_TTL="8h"
JWT_REFRESH_TTL="30d"
# Frontend origin yang diizinkan (CORS)
CORS_ORIGIN=http://localhost:5173
# Aktifkan OTP preview di log/respon saat development (nonaktif di production)
OTP_DEV_PREVIEW=true

# ===== Aturan Absensi =====
# Batas jam (WIB) untuk status "terlambat", misal 07:00
LATE_AFTER_HOUR=7
LATE_AFTER_MINUTE=0
# Batas akhir absen datang: setelah jam ini siswa tidak bisa absen datang sendiri
# (dianggap tidak hadir - koreksi manual oleh petugas). 23:59 = tidak dibatasi.
CHECK_IN_DEADLINE_HOUR=23
CHECK_IN_DEADLINE_MINUTE=59
# Radius lokasi absensi (meter) - 0 untuk nonaktif
LOCATION_RADIUS_METERS=100
LOCATION_ENABLED=false
SCHOOL_LATITUDE=-6.2088
SCHOOL_LONGITUDE=106.8456

# ===== Storage (S3-compatible / local) =====
STORAGE_DRIVER=local
STORAGE_ENDPOINT=
STORAGE_BUCKET=presensiku
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_URL=

# ===== Face Recognition Provider =====
# facenet-web = deteksi wajah di HP siswa (face-api.js), server hanya membandingkan descriptor
# Pengenalan wajah: descriptor dihitung di HP (face-api.js), dibandingkan di server
FACE_RECOGNITION_PROVIDER=facenet-web
# Jarak euclidean maksimum agar wajah dianggap cocok (default 0.6)
FACE_MATCH_THRESHOLD=0.6
# Margin minimum ke wajah kedua (cegah salah kenal saat banyak siswa, default 0.15)
FACE_MATCH_MARGIN=0.15

# ===== Notifikasi =====
WHATSAPP_PROVIDER=none
WHATSAPP_API_KEY=

# ===== SMTP =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ===== Port =====
API_PORT=4000
WEB_PORT=5173

# ===== Opsional: Redis (digunakan di docker-compose untuk rate limit/session) =====
REDIS_URL=

# ===== SSO dari SDMS (Single Sign-On) =====
# Harus sama persis dengan SSO_SECRET_ABSEN di .env SDMS
SSO_SECRET=sso_secret_absen_smkn1kras_2026
SSO_APP_NAME=absen
